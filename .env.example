# ==============================================================================
# Telegram Credentials
# Obtain these free in 1 minute from: https://my.telegram.org -> 'API development tools'
# ==============================================================================
API_ID=12345678
API_HASH=your_api_hash_here

# Optional: Your phone number with international country code (e.g. +1234567890)
# If left empty, you will be prompted for it in the terminal on first run.
PHONE_NUMBER=

# Target folder where files will be saved.
# Example for Linux: /HDD/Hard_Disk_Drive/Downloads/
DOWNLOAD_DIR=/HDD/Hard_Disk_Drive/Downloads/

# Session file name (will create telegram_session.session in project directory)
SESSION_NAME=telegram_session

# Optional: Healthchecks.io ping URL for monitoring daemon uptime
HEALTHCHECK_URL=https://hc-ping.com/xxxx-xxxx-xxxx
